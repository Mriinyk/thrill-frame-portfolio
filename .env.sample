# Django production settings
SECRET_KEY=replace-with-a-new-production-secret
DJANGO_SETTINGS_MODULE=thrill_frame_web_portfolio_servis.settings.production
ALLOWED_HOSTS=your-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com

# Render sets this automatically; do not add a manual value in the dashboard.
# RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com

# Neon PostgreSQL connection
POSTGRES_DB=your_database_name
POSTGRES_PORT=5432
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=your-neon-endpoint-hostname
POSTGRES_SSLMODE=require
POSTGRES_CHANNEL_BINDING=require

# Optional Telegram contact notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
